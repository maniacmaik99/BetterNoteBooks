{
	"name": "obsidian-betternotebooks",
	"version": "1.1.0",
	"description": "Create multi-page digital notebooks in your vault with smooth handwriting, geometric shapes, and palm rejection.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"drawing",
		"handwriting",
		"goodnotes",
		"notebook"
	],
	"author": "Maik Schultheiß <mksc0228@hochschule-trier.de>",
	"repository": "https://github.com/maniacmaik99/BetterNoteBooks",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
